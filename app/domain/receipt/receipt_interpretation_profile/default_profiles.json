          "strategy": "regex",
          "patterns": [
            "Vencimento\\s+(?P<value>\\d{2}\\s+[A-Z]{3}\\s+\\d{4})"
          ],
          "parser": "date_month_name_pt_br",
          "normalization": "strip",
          "fallback_field": null
        },
        "is_active": true
      },
      {
        "field_name": "payment_date",
        "configuration": {
          "strategy": "regex",
          "patterns": [
            "(?P<value>[0-9NIL]{2}\\s+[A-Z]{3}\\s+\\d{4})(?:\\s*-\\s*\\d{2}:\\d{2}:\\d{2})?"
          ],
          "parser": "date_month_name_pt_br",
          "normalization": "ocr_day",
          "fallback_field": null
        },
        "is_active": true
      },
      {
        "field_name": "source_institution",
        "configuration": {
          "strategy": "constant",
          "value": "Nubank"
        },
        "is_active": true
      }
    ]
  },
